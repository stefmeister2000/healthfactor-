# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore en gaat NOOIT naar GitHub.

# Full-access API key uit Resend (API Keys -> Create -> Full access).
# De "send-only" key volstaat NIET om contacten aan een audience toe te voegen.
RESEND_API_KEY=

# ID van je Resend Audience (Audiences -> jouw lijst -> ID in de URL/instellingen).
RESEND_AUDIENCE_ID=
