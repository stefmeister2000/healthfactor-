# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore en gaat NOOIT naar GitHub.

# Full-access API key uit Resend (API Keys -> Create -> Full access).
# De "send-only" key volstaat NIET om contacten aan een audience toe te voegen.
RESEND_API_KEY=

# ID van je Resend Audience (Audiences -> jouw lijst -> ID in de URL/instellingen).
RESEND_AUDIENCE_ID=

# Server-only intake key for the Healthfactor company in Sales CRM.
# Never use the Verkoop Studio token or put this key in HTML/browser JavaScript.
CRM_INBOUND_URL=https://crm.verkoop.studio/api/public/inbound-lead
CRM_INBOUND_TOKEN=

# Local optional storage directory. Production uses a Railway volume at /data.
# HEALTHFACTOR_DATA_DIR=/absolute/path/to/private/data
